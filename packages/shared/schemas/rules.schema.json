{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/rules.schema.json",
  "title": "Module Rules Configuration",
  "description": "Schema for rules.yaml of a module - defines validation or business rules with manual edit tracking",
  "type": "object",
  "additionalProperties": false,
  "required": ["_version", "manually_edited"],
  "properties": {
    "_version": {
      "type": "string",
      "description": "Schema version for evolution tracking"
    },
    "manually_edited": {
      "type": "boolean",
      "description": "Indicates if this rules file has been manually edited by a human"
    },
    "rules": {
      "type": "array",
      "description": "List of rules defined for this module",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the rule (e.g. R-001 or <view>.<field>.<tipo>)"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the rule"
          },
          "condition": {
            "type": "string",
            "description": "Condition expression for the rule"
          },
          "action": {
            "type": "string",
            "description": "Action to take when rule is triggered"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Severity level of the rule"
          },
          "tags": {
            "type": "array",
            "description": "Tags associated with the rule",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "view": {
            "type": "string",
            "description": "Vista o pantalla a la que aplica esta regla (ej: 'default', 'login')"
          },
          "category": {
            "type": "string",
            "enum": ["proposito", "actor", "campo", "accion", "error", "dato", "sensibilidad"],
            "description": "Categoría semántica de la regla"
          },
          "status": {
            "type": "string",
            "enum": ["inferred", "confirmed", "rejected", "deferred"],
            "description": "Estado de confirmación de la regla. deferred = pendiente por decisión explícita del usuario"
          },
          "source": {
            "type": "string",
            "enum": ["dom", "prd", "user"],
            "description": "Procedencia de la regla"
          },
          "field": {
            "type": "string",
            "description": "Campo o selector al que aplica la regla (si aplica)"
          },
          "evidence": {
            "type": "string",
            "description": "Evidencia corta (selector CSS o referencia). Truncada a 120 caracteres."
          }
        }
      },
      "default": []
    },
    "category_waivers": {
      "type": "array",
      "description": "Categorías que el usuario declara 'no aplica' para esta vista. Solo source user.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view", "category", "reason"],
        "properties": {
          "view": {
            "type": "string",
            "description": "Vista a la que aplica el waiver"
          },
          "category": {
            "type": "string",
            "enum": ["proposito", "actor", "campo", "accion", "error", "dato", "sensibilidad"],
            "description": "Categoría declarada como no aplicable"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Razón declarada por el usuario de por qué no aplica"
          }
        }
      },
      "default": []
    }
  }
}

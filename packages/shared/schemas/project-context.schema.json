{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/project-context.schema.json",
  "title": "Project Context Configuration",
  "description": "Schema for .qa/project/context.yaml including business context and provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_version",
    "project_name"
  ],
  "properties": {
    "_version": {
      "type": "string",
      "description": "Schema version for evolution tracking"
    },
    "project_name": {
      "type": "string",
      "description": "Name of the project",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "General description or overview of the project"
    },
    "tech_stack": {
      "type": "array",
      "description": "Technologies used in the project",
      "items": {
        "type": "string"
      }
    },
    "base_url": {
      "type": "string",
      "description": "Base URL of the application"
    },
    "manually_edited": {
      "type": "boolean",
      "description": "Indicates if the file was manually edited"
    },
    "objective": {
      "type": "string",
      "description": "Primary business objective or problem being solved"
    },
    "objective_source": {
      "type": "string",
      "description": "Provenance of the objective field",
      "enum": [
        "user",
        "prd",
        "inferred"
      ]
    },
    "roles": {
      "type": "array",
      "description": "User roles participating in the system",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name or identifier of the user role"
          },
          "description": {
            "type": "string",
            "description": "Optional description of role responsibilities"
          },
          "source": {
            "type": "string",
            "description": "Provenance of the role definition",
            "enum": [
              "user",
              "prd",
              "inferred"
            ]
          }
        }
      }
    },
    "critical_flows": {
      "type": "array",
      "description": "Critical business user flows",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name or title of the critical flow"
          },
          "description": {
            "type": "string",
            "description": "Description of the steps or flow intent"
          },
          "priority": {
            "type": "string",
            "description": "Priority of this critical flow (e.g. high, critical, normal)"
          },
          "source": {
            "type": "string",
            "description": "Provenance of the critical flow definition",
            "enum": [
              "user",
              "prd",
              "inferred"
            ]
          }
        }
      }
    },
    "source_of_truth": {
      "type": "object",
      "description": "Specification source of truth declaration",
      "additionalProperties": false,
      "required": [
        "type",
        "declared"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "prd",
            "readme",
            "notes",
            "none"
          ],
          "description": "Type of source of truth"
        },
        "ref": {
          "type": "string",
          "description": "Reference file path, URL, or identifier"
        },
        "notes": {
          "type": "string",
          "description": "Registered notes if type is notes or supplemental context"
        },
        "declared": {
          "type": "boolean",
          "description": "Whether the source of truth has been explicitly declared"
        },
        "source": {
          "type": "string",
          "description": "Provenance of the source of truth definition",
          "enum": [
            "user",
            "prd",
            "inferred"
          ]
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/tc-case.schema.json",
  "title": "Test Case Definition",
  "description": "Schema for TC-*.yaml files - defines a test case with id, name, tags, dependencies, and steps",
  "type": "object",
  "additionalProperties": false,
  "required": ["_version", "id", "name", "steps"],
  "properties": {
    "_version": {
      "type": "string",
      "description": "Schema version for evolution tracking"
    },
    "id": {
      "type": "string",
      "description": "Unique identifier (UUID) for the test case",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Name of the test case"
    },
    "tags": {
      "type": "array",
      "description": "Tags associated with the test case",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "depends_on": {
      "type": "array",
      "description": "Other test cases this case depends on",
      "items": {
        "type": "string"
      },
      "default": null
    },
    "steps": {
      "type": "array",
      "description": "List of steps to execute in this test case",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["navigate", "fill", "click", "assert", "waitFor", "screenshot", "capture", "switch_auth", "evaluate", "intercept_network"],
            "description": "Type of action to perform"
          },
          "selector": {
            "type": "string",
            "description": "CSS selector or logical selector name for the target element"
          },
          "value": {
            "type": "string",
            "description": "Value to fill or use in the action"
          },
          "url": {
            "type": "string",
            "description": "URL to navigate to (for navigate type)"
          },
          "timeout": {
            "type": "integer",
            "description": "Timeout in milliseconds for wait actions",
            "minimum": 0
          },
          "expected": {
            "type": "string",
            "description": "Expected value for assertions"
          },
          "assertion_type": {
            "type": "string",
            "enum": ["equals", "contains", "visible", "exists", "not_visible", "not_exists"],
            "description": "Type of assertion to perform"
          },
          "filename": {
            "type": "string",
            "description": "Filename for screenshot (optional, auto-generated if not provided)"
          },
          "capture_as": {
            "type": "string",
            "description": "Variable name to store captured value as"
          },
          "auth_profile": {
            "type": "string",
            "description": "Auth profile name to switch to (for switch_auth type)"
          },
          "expression": {
            "type": "string",
            "description": "JavaScript expression to evaluate (for evaluate type)"
          },
          "intercept_config": {
            "type": "object",
            "description": "Configuration for network interception",
            "additionalProperties": false,
            "properties": {
              "url_pattern": {
                "type": "string",
                "description": "URL pattern to intercept"
              },
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
                "description": "HTTP method to intercept"
              },
              "response_override": {
                "type": "object",
                "description": "Response to return instead",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": {
            "type": "string",
            "description": "Optional description of what this step does"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "navigate" } },
              "required": ["type"]
            },
            "then": {
              "required": ["url"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "fill" } },
              "required": ["type"]
            },
            "then": {
              "required": ["selector", "value"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "click" } },
              "required": ["type"]
            },
            "then": {
              "required": ["selector"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "assert" } },
              "required": ["type"]
            },
            "then": {
              "required": ["selector", "assertion_type"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "waitFor" } },
              "required": ["type"]
            },
            "then": {
              "oneOf": [
                { "required": ["selector"] },
                { "required": ["timeout"] }
              ]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "capture" } },
              "required": ["type"]
            },
            "then": {
              "required": ["selector", "capture_as"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "switch_auth" } },
              "required": ["type"]
            },
            "then": {
              "required": ["auth_profile"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "evaluate" } },
              "required": ["type"]
            },
            "then": {
              "required": ["expression"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "intercept_network" } },
              "required": ["type"]
            },
            "then": {
              "required": ["intercept_config"]
            }
          }
        ]
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/execution-result.schema.json",
  "title": "ExecutionResult",
  "description": "Schema for structured test execution results adhering to QAP v2.1 Sprint 5 contract (S5-001)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_version",
    "execution_id",
    "module",
    "env",
    "started_at",
    "finished_at",
    "result",
    "timed_out",
    "summary",
    "cases"
  ],
  "properties": {
    "_version": {
      "type": "string",
      "const": "1",
      "description": "Versión del esquema de ejecución. Debe ser exactamente '1' (Principio 9)."
    },
    "execution_id": {
      "type": "string",
      "description": "Identificador único de ejecución con formato <timestamp>_<modulo>_<uuid-corto>"
    },
    "module": {
      "type": "string",
      "description": "Nombre del módulo evaluado"
    },
    "env": {
      "type": "string",
      "description": "Entorno de ejecución (ej. local, staging, production)"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 de inicio de la ejecución"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 de fin de la ejecución"
    },
    "result": {
      "type": "string",
      "enum": ["passed", "failed", "partial", "error"],
      "description": "Resultado global de la ejecución"
    },
    "timed_out": {
      "type": "boolean",
      "description": "Indica si la ejecución excedió el tiempo límite"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Resumen cuantitativo de la ejecución",
      "required": ["total", "passed", "failed", "skipped", "not_run"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total de casos evaluados"
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Casos pasados exitosamente"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Casos con fallo"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Casos omitidos intencionalmente"
        },
        "not_run": {
          "type": "integer",
          "minimum": 0,
          "description": "Casos no ejecutados (ej. por dependencia no satisfecha)"
        }
      }
    },
    "attempt_id": {
      "type": ["string", "null"],
      "description": "Identificador del intento de ejecución asociado"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Artefactos físicos de evidencia Playwright asociados al intento",
      "properties": {
        "video_path": { "type": ["string", "null"] },
        "trace_zip_path": { "type": ["string", "null"] },
        "timeline_path": { "type": ["string", "null"] },
        "screenshots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "message"],
            "properties": {
              "artifact": { "type": "string" },
              "case_id": { "type": ["string", "null"] },
              "step_index": { "type": ["integer", "null"], "minimum": 0 },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "description": "Timeline cronológico de pasos del intento",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_index", "case_id", "action", "status", "started_at", "finished_at", "duration_ms"],
        "properties": {
          "step_index": { "type": "integer", "minimum": 0 },
          "case_id": { "type": "string" },
          "action": { "type": "string" },
          "selector": { "type": ["string", "null"] },
          "expected": { "type": ["string", "null"] },
          "observed": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "started_at": { "type": "string" },
          "finished_at": { "type": "string" },
          "duration_ms": { "type": "number", "minimum": 0 },
          "message": { "type": ["string", "null"] },
          "screenshot": { "type": ["string", "null"] },
          "focused_screenshot": { "type": "boolean" },
          "redacted_selectors_count": { "type": "integer", "minimum": 0 },
          "artifact_error": { "type": ["string", "null"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "description": "Lista de casos ejecutados en el módulo",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "result"],
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID o slug identificador del caso de prueba"
          },
          "title": {
            "type": "string",
            "description": "Título descriptivo del caso"
          },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "not_run"],
            "description": "Resultado específico de este caso"
          },
          "failure_type": {
            "type": ["string", "null"],
            "enum": [
              "assertion_failed",
              "execution_timeout",
              "selector_not_found",
              "network_error",
              "auth_failed",
              null
            ],
            "description": "Categorización del fallo si el caso no pasó"
          },
          "not_run_reason": {
            "type": ["string", "null"],
            "description": "Motivo por el que no se ejecutó el caso (ej. dependencia fallida)"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0,
            "description": "Duración de la ejecución del caso en milisegundos"
          },
          "attempt_id": {
            "type": ["string", "null"]
          },
          "video_path": {
            "type": ["string", "null"]
          },
          "trace_zip_path": {
            "type": ["string", "null"]
          },
          "timeline_path": {
            "type": ["string", "null"]
          },
          "artifact_errors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "steps": {
            "type": "array",
            "description": "Pasos detallados ejecutados dentro del caso",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "status"],
              "properties": {
                "step_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Índice del paso dentro del caso"
                },
                "action": {
                  "type": "string",
                  "description": "Acción ejecutada en el paso"
                },
                "selector": {
                  "type": ["string", "null"],
                  "description": "Selector objetivo de la acción si aplica"
                },
                "expected": {
                  "type": ["string", "null"],
                  "description": "Valor o condición esperada en el paso"
                },
                "observed": {
                  "type": ["string", "null"],
                  "description": "Valor o estado observado en el paso"
                },
                "started_at": {
                  "type": ["string", "null"],
                  "description": "Timestamp ISO 8601 de inicio del paso"
                },
                "finished_at": {
                  "type": ["string", "null"],
                  "description": "Timestamp ISO 8601 de fin del paso"
                },
                "redacted_selectors_count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Número de selectores redactados o anonimizados en este paso"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Duración del paso en milisegundos"
                },
                "status": {
                  "type": "string",
                  "description": "Estado resultante del paso"
                },
                "message": {
                  "type": ["string", "null"],
                  "description": "Mensaje informativo o detalle de error"
                },
                "screenshot": {
                  "type": ["string", "null"],
                  "description": "Ruta relativa a captura de pantalla tomada en este paso"
                },
                "focused_screenshot": {
                  "type": "boolean",
                  "description": "Indica si la captura fue enfocada sobre el elemento objetivo"
                },
                "artifact_error": {
                  "type": ["string", "null"],
                  "description": "Causa del fallo de captura de evidencia en este paso, si ocurrió"
                }
              }
            }
          },
          "screenshots": {
            "type": "array",
            "description": "Rutas relativas a capturas PNG asociadas al caso",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

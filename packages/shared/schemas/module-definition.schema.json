{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/module-definition.schema.json",
  "title": "Module Definition v3",
  "description": "Schema for a module containing capabilities in QAP v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "ownerSquad": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "qap://schemas/capability-definition.schema.json"
      }
    }
  }
}

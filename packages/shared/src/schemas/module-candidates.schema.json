{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/module-candidates.schema.json",
  "title": "ModuleCandidates",
  "description": "Schema for .qa/project/module-candidates.json representing candidate modules for testing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_version",
    "candidates"
  ],
  "properties": {
    "_version": {
      "type": "string",
      "description": "Schema version for evolution tracking"
    },
    "candidates": {
      "type": "array",
      "description": "List of candidate modules",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "ruta",
          "fuentes",
          "flujos",
          "confianza",
          "evidencia"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "ruta": {
            "type": [
              "string",
              "null"
            ]
          },
          "fuentes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "doc",
                "repo"
              ]
            },
            "uniqueItems": true
          },
          "flujos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confianza": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          },
          "evidencia": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/module-repo-map.schema.json",
  "title": "Module Repo Map",
  "description": "Schema for repo-map.json of a module mapping source code files to the module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_version",
    "module",
    "files"
  ],
  "properties": {
    "_version": {
      "type": "string",
      "const": "1",
      "description": "Schema version const 1"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "description": "Identifying name of the module"
    },
    "files": {
      "type": "array",
      "description": "Source code file paths belonging to this module (POSIX format)",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qap://schemas/project-init.schema.json",
  "title": "Project Init Configuration",
  "description": "Schema for non-interactive qap init configuration (project name, environments, flags)",
  "type": "object",
  "additionalProperties": false,
  "required": ["_version", "projectName"],
  "properties": {
    "_version": {
      "type": "string",
      "description": "Schema version for evolution tracking"
    },
    "projectName": {
      "type": "string",
      "description": "Name of the QAP project",
      "minLength": 1
    },
    "environments": {
      "type": "array",
      "description": "List of environment names to initialize",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "flags": {
      "type": "object",
      "description": "Initialization flags",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "skipGit": {
          "type": "boolean",
          "description": "Skip Git repository initialization",
          "default": false
        },
        "skipInstall": {
          "type": "boolean",
          "description": "Skip dependency installation",
          "default": false
        },
        "template": {
          "type": "string",
          "description": "Template to use for project initialization",
          "default": "default"
        }
      }
    }
  }
}

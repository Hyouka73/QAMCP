{
  "name": "@qap/cli",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qap": "./dist/entrypoint.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/entrypoint.ts --format esm --dts",

{
  "name": "@qap/cli",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qap": "./dist/entrypoint.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/entrypoint.ts --format esm --dts",
    "dev": "tsup src/index.ts src/entrypoint.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:playwright-spike": "tsx src/runner.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "@qap/auth": "workspace:^",
    "@qap/shared": "workspace:^",
    "@qap/engine": "workspace:^",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "playwright-core": "^1.62.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.11"
  }
}

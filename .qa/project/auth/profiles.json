{
  "profiles": [
    {
      "id": "default",
      "env": "dev",
      "username": "user",
      "login_mode": "auto",
      "login_route": "/login",
      "session_cache": {
        "enabled": true
      },
      "post_login_condition": {
        "type": "url_contains",
        "value": "/dashboard"
      },
      "handoff_timeout_ms": 30000,
      "credential_source": "keychain"
    }
  ]
}